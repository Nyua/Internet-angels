{
  "name": "internet-angel",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "build": "node ./scripts/build-site.js",
    "build:e2e": "node ./scripts/build-site.js --allow-oversized-assets",
    "dev": "npm run build:e2e && wrangler pages dev dist --port 8788",
    "dev:serve": "wrangler pages dev dist --port 8788",
    "deploy:pages": "node ./scripts/deploy-pages.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/*.test.js",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "wrangler": "^4.18.0"
  }
}
