{"type":"before","callId":"pw:api@41","stepId":"pw:api@41","startTime":134635.475,"class":"Test","method":"pw:api","title":"Add init script","params":{"source":"(() => {\n    window.__spotifyEmbedControllers = [];\n    const createController = (target, options, callback) => {\n      const listeners = new Map();\n      if (target instanceof HTMLElement) {\n        target.innerHTML = \"\";\n        const iframe = document.createElement(\"iframe\");\n        iframe.className = \"lastfm-track-panel-spotify-embed\";\n        iframe.src = \"about:blank\";\n        iframe.title = \"Stub Spotify embed\";\n        iframe.setAttribute(\"aria-hidden\", \"true\");\n        target.appendChild(iframe);\n      }\n      const emit = (eventName, payload) => {\n        const handlers = listeners.get(eventName) || [];\n        handlers.forEach(handler => {\n          try {\n            handler(payload);\n          } catch {}\n        });\n      };\n      const controller = {\n        addListener(eventName, handler) {\n          const handlers = listeners.get(eventName) || [];\n          handlers.push(handler);\n          listeners.set(eventName, handlers);\n        },\n        pause() {\n          emit(\"playback_update\", {\n            data: {\n              isPaused: true\n            }\n          });\n        },\n        destroy() {\n          if (target instanceof HTMLElement) {\n            target.innerHTML = \"\";\n          }\n        },\n        __emit: emit\n      };\n      window.__spotifyEmbedControllers.push({\n        controller,\n        options\n      });\n      callback?.(controller);\n    };\n    window.__internetAngelSpotifyIframeApi = {\n      createController\n    };\n    window.__emitSpotifyIframeEvent = (index, eventName, payload) => {\n      const entry = window.__spotifyEmbedControllers?.[index];\n      entry?.controller?.__emit?.(eventName, payload);\n    };\n  })(undefined)"},"stack":[{"file":"C:\\dev\\Internet-angel\\tests\\site.smoke.spec.js","line":27,"column":3,"function":"stubSpotifyIframeApi"}],"group":"configuration"}
