{"type":"before","callId":"call@11","startTime":134635.618,"class":"Page","method":"addInitScript","params":{"source":"(() => {\n    window.__spotifyEmbedControllers = [];\n    const createController = (target, options, callback) => {\n      const listeners = new Map();\n      if (target instanceof HTMLElement) {\n        target.innerHTML = \"\";\n        const iframe = document.createElement(\"iframe\");\n        iframe.className = \"lastfm-track-panel-spotify-embed\";\n        iframe.src = \"about:blank\";\n        iframe.title = \"Stub Spotify embed\";\n        iframe.setAttribute(\"aria-hidden\", \"true\");\n        target.appendChild(iframe);\n      }\n      const emit = (eventName, payload) => {\n        const handlers = listeners.get(eventName) || [];\n        handlers.forEach(handler => {\n          try {\n            handler(payload);\n          } catch {}\n        });\n      };\n      const controller = {\n        addListener(eventName, handler) {\n          const handlers = listeners.get(eventName) || [];\n          handlers.push(handler);\n          listeners.set(eventName, handlers);\n        },\n        pause() {\n          emit(\"playback_update\", {\n            data: {\n              isPaused: true\n            }\n          });\n        },\n        destroy() {\n          if (target instanceof HTMLElement) {\n            target.innerHTML = \"\";\n          }\n        },\n        __emit: emit\n      };\n      window.__spotifyEmbedControllers.push({\n        controller,\n        options\n      });\n      callback?.(controller);\n    };\n    window.__internetAngelSpotifyIframeApi = {\n      createController\n    };\n    window.__emitSpotifyIframeEvent = (index, eventName, payload) => {\n      const entry = window.__spotifyEmbedControllers?.[index];\n      entry?.controller?.__emit?.(eventName, payload);\n    };\n  })(undefined)"},"stepId":"pw:api@41","pageId":"page@c046c966e2dc7c58bb38d04debd19b45"}
